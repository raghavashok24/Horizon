@dataclass
class SimConfig:
    theta0: float = THETA0
    kappa:  float = KAPPA
    r0:     float = R0
    M:      int   = M
    profile: dict = field(default_factory=lambda: FEDWIRE)

def hourly_counts(n_total, profile, rng):
    """Distribute n_total releasable payments across the operating day."""
    hours  = list(profile.keys())
    shares = np.array(list(profile.values()))
    return dict(zip(hours, rng.multinomial(n_total, shares / shares.sum())))

def run_day(a, cfg=SimConfig(), rng=rng):
    """One simulated operating day at release intensity a in [0,1].

    Mechanism
    ---------
    theta  latent system tightness in [0,1]; 1 = maximally congested.
    Ego releases n = a*M payments. Each triggers a counterparty response whose
    delay is Exp(rate = r0*(1-theta)): a tight system responds slowly.
    Releasing injects liquidity, so theta declines:  theta(a) = theta0 - kappa*a.

    The observable is the set of response delays. Nothing about other banks'
    states, queues, or actions is observed.
    """
    n = max(int(round(a * cfg.M)), 3)
    theta = cfg.theta0 - cfg.kappa * a          # relief: the probe depletes the state
    theta = float(np.clip(theta, 0.0, 1.0))
    rate  = cfg.r0 * (1.0 - theta)
    delays = rng.exponential(1.0 / rate, size=n)
    return {"a": a, "theta_true": theta, "n_obs": n, "delays": delays,
            "hourly": hourly_counts(n, cfg.profile, rng)}

# Acceptance test: theta falls with a; delays shorten as the system loosens
print(f"{'a':>5}{'theta':>8}{'n':>6}{'mean delay':>12}")
for a in (0.0, 0.25, 0.5, 0.75, 1.0):
    d = run_day(a)
    print(f"{a:5.2f}{d['theta_true']:8.3f}{d['n_obs']:6d}{d['delays'].mean():12.3f}")

    def estimate_theta(delays, cfg=SimConfig()):
    """MLE of theta from observed response delays.

    delays ~ Exp(rate = r0*(1-theta)).  The unbiased MLE of an exponential rate
    from n observations is (n-1)/sum(d), which we invert to recover theta.
    Fisher information per observation is 1/(1-theta)^2 -- it FALLS as the system
    loosens, because a fast-responding system produces tightly clustered delays
    with little dispersion to read.
    """
    n = len(delays)
    rate_hat = (n - 1) / delays.sum()
    return float(np.clip(1.0 - rate_hat / cfg.r0, -1.0, 1.0))

def sweep_point(a, K=6000, cfg=SimConfig(), rng=rng):
    n = max(int(round(a * cfg.M)), 3)
    theta = float(np.clip(cfg.theta0 - cfg.kappa * a, 0.0, 1.0))
    d = rng.exponential(1.0 / (cfg.r0 * (1 - theta)), size=(K, n))
    est = 1.0 - ((n - 1) / d.sum(1)) / cfg.r0
    return {"a": a, "theta_true": theta, "n_obs": n,
            "bias": est.mean() - theta, "info_emp": 1.0 / est.var(),
            "info_analytic": n / (1 - theta) ** 2}

print(f"{'a':>5}{'theta':>8}{'n':>6}{'bias':>10}")
for a in (0.05, 0.2, 0.5, 1.0):
    r = sweep_point(a, K=6000)
    print(f"{r['a']:5.2f}{r['theta_true']:8.3f}{r['n_obs']:6d}{r['bias']:10.5f}")
print("\nPASS if |bias| < 0.005 everywhere -- estimator and generative model agree.")

